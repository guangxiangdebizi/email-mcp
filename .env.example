# MCP Streamable HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=3200
MCP_PATH=/mcp
# Optional but recommended when the service is reachable over a network
# MCP_API_KEY=replace-with-a-long-random-value
# Optional browser CORS origin; comma-separated origins are supported
# MCP_CORS_ORIGIN=https://your-client.example

# Default provider: imap-smtp (aliases: smtp, imap, standard)
EMAIL_PROVIDER=imap-smtp

# Standard SMTP settings for send_email and reply_email
# Hosts are inferred for QQ, 163/126/yeah.net, Gmail, Outlook/Hotmail,
# Yahoo and iCloud when the account address matches one of those domains.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@163.com
SMTP_PASS=your-app-password-or-authorization-code
# SMTP_ACCESS_TOKEN=
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Standard IMAP settings for read_emails, search_emails and delete_email
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@163.com
IMAP_PASS=your-app-password-or-authorization-code
# IMAP_ACCESS_TOKEN=
# IMAP_TLS_REJECT_UNAUTHORIZED=true

DEFAULT_FROM_EMAIL=your-email@163.com

# Optional named accounts. Keep JSON on one line in a .env file.
# EMAIL_DEFAULT_ACCOUNT=personal
# EMAIL_ACCOUNTS_JSON={"personal":{"provider":"imap-smtp","from":"me@qq.com","smtp":{"user":"me@qq.com","pass":"qq-authorization-code"},"imap":{"user":"me@qq.com","pass":"qq-authorization-code"}},"work":{"provider":"imap-smtp","from":"me@outlook.com","smtp":{"user":"me@outlook.com","pass":"app-password"},"imap":{"user":"me@outlook.com","pass":"app-password"}}}

# Optional backward-compatible Gmail API mode
# EMAIL_PROVIDER=gmail-api
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_ACCESS_TOKEN=
# DEFAULT_FROM_EMAIL=your-email@gmail.com
